{
    "compilerOptions": {
      "rootDir": "./",
      "outDir": "./dist",
      "module": "commonjs",
      "target": "es2025",
      "types": ["node"],
      "lib": ["esnext"],
      // Other Outputs
      "sourceMap": true,
      "declaration": true,
      "declarationMap": true,

      // Stricter Typechecking Options
      "noUncheckedIndexedAccess": true,
      "exactOptionalPropertyTypes": true,
      // Recommended Options
      "strict": true,
      "isolatedModules": true,
      "noUncheckedSideEffectImports": true,
      "moduleDetection": "force",
      "skipLibCheck": true,
    }
  }
